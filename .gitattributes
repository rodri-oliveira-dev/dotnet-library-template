# Normalize arquivos de texto e mantenha diffs estáveis entre Windows, Linux e CI.
* text=auto eol=lf

# Código e arquivos de projeto/configuração usam LF explicitamente.
*.cs             text eol=lf
*.csproj         text eol=lf
*.props          text eol=lf
*.targets        text eol=lf
*.sln            text eol=lf
*.slnx           text eol=lf
*.json           text eol=lf
*.xml            text eol=lf
*.yaml           text eol=lf
*.yml            text eol=lf
*.md             text eol=lf
*.editorconfig   text eol=lf
*.gitignore      text eol=lf
*.gitattributes  text eol=lf
*.sh             text eol=lf
*.ps1            text eol=lf

# Scripts de cmd.exe permanecem em CRLF por compatibilidade com ferramentas Windows legadas.
*.cmd            text eol=crlf
*.bat            text eol=crlf

# Binários não devem sofrer normalização de texto.
*.png             binary
*.jpg             binary
*.jpeg            binary
*.gif             binary
*.ico             binary
*.pdf             binary
*.zip             binary
*.dll             binary
*.exe             binary
*.nupkg           binary
*.snupkg          binary
