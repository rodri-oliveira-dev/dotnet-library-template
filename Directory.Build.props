<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>10-recommended</AnalysisLevel>
    <AnalysisLevelSecurity>10-all</AnalysisLevelSecurity>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Single source of truth for local/development builds. Release tags override Version in release.yml. -->
    <VersionPrefix>1.0.0</VersionPrefix>

    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- Low/moderate vulnerabilities remain visible; high/critical vulnerabilities fail restore/build. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902</WarningsNotAsErrors>
    <WarningsAsErrors>$(WarningsAsErrors);NU1903;NU1904</WarningsAsErrors>

    <RestoreEnablePackagePruning>true</RestoreEnablePackagePruning>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

    <Deterministic>true</Deterministic>
    <!-- CI builds embed deterministic source/build metadata consistently across environments. -->
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true' Or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
