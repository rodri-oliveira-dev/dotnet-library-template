<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <IsPackable>true</IsPackable>
    <EnablePackageValidation>true</EnablePackageValidation>

    <!-- NuGet metadata -->
    <PackageId>Template.Library</PackageId>
    <Title>Template.Library</Title>
    <Authors>TODO: Set package authors.</Authors>
    <Description>
      TODO: Describe the library before publishing.
    </Description>
    <PackageTags>dotnet;csharp;library;net10;nuget</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!-- NuGet presentation -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>nuget-icon.png</PackageIcon>

    <!-- Repository -->
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>

    <!-- Documentation and symbols -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md"
          Pack="true"
          PackagePath="/" />

    <None Include="../../resources/nuget-icon.png"
          Pack="true"
          PackagePath="/" />
  </ItemGroup>
</Project>
